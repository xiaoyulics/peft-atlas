\newcommand{\fbwith}[1]{\par\vspace{0.35em}{\small\itshape\color{inkgray}#1\par}}
\newcommand{\fbauthors}[1]{\begin{tabular}{@{}p{0.5\linewidth}@{}p{0.5\linewidth}@{}}#1\end{tabular}}
\renewcommand{\maketitle}{%
  \thispagestyle{plain}%
  \begingroup\raggedright
  \ifx\fb@kicker\@empty\else{\sffamily\footnotesize\color{tide}\textls[180]{\MakeUppercase{\fb@kicker}}\par}\vspace{0.6em}\fi
  {\fontsize{25}{30}\selectfont\bfseries\color{ink}\@title\par}%
  \ifx\fb@subtitle\@empty\else\vspace{0.45em}{\fontsize{18}{22}\selectfont\color{tide}\fb@subtitle\par}\fi
  \vspace{0.6em}
  {\@author\par}\vspace{0.55em}
  {\sffamily\footnotesize\color{inkgray}\@date\par}
  \ifx\fb@companion\@empty\else\vspace{0.3em}{\sffamily\footnotesize\color{inkgray}\fb@companion\par}\fi
  \par\endgroup\vspace{0.5em}
  {\color{rulegray}\rule{\linewidth}{0.4pt}}\par\vspace{0.4em}%
  \global\let\fb@footnoterule\footnoterule
  \gdef\footnoterule{\kern-3\p@{\color{rulegray}\hrule\@width\linewidth\@height0.4\p@}\kern2.6\p@}%
  \AddToHookNext{shipout/after}{\global\let\footnoterule\fb@footnoterule}}
\renewenvironment{abstract}{\par\noindent{\sffamily\footnotesize\bfseries\color{tide}\textls[160]{ABSTRACT}}\par\vspace{0.3em}\noindent\ignorespaces}{\par\ifx\fb@reportnote\@empty\else\vspace{0.55em}{\footnotesize\itshape\color{inkgray}\noindent\fb@reportnote\par}\fi\par}

