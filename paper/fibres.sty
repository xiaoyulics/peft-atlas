% fibres.sty — house style for "A Categorical Atlas of Parameter-Efficient Fine-Tuning: Cones, Orbits, and Gauges"
% A restrained mathematical-manuscript look that shares the companion site's identity:
% Source Serif text, newtx mathematics, IBM Plex Sans for labels, IBM Plex Mono for code and numbers,
% one tidal-teal accent, SGA-style "Exposé" numbering (I, II, III, ...) so that every result
% carries the same number in the paper and on the site (Theorem II.7, Corollary III.11, ...).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{fibres}[2026/10/03 Categorical Atlas of PEFT house style]

% ---------------------------------------------------------------- page
\RequirePackage[a4paper,textwidth=15.4cm,textheight=23.6cm,top=3.1cm,headheight=14pt,headsep=0.9cm,footskip=1.1cm]{geometry}

% ---------------------------------------------------------------- fonts
\RequirePackage[T1]{fontenc}
\RequirePackage{amsmath,amssymb,mathtools,amsthm}
\IfFileExists{sourceserif.sty}{\RequirePackage{sourceserif}}{\RequirePackage{sourceserifpro}}% older TeX Live ships the same faces as sourceserifpro
\RequirePackage[scale=0.86]{plex-sans}
\RequirePackage[scale=0.84]{plex-mono}
\RequirePackage[varbb,smallerops,cmintegrals]{newtxmath}
\RequirePackage[final,protrusion=true,expansion=true,tracking=true]{microtype}
\linespread{1.06}
\setlength{\parskip}{0pt}
% one word space after a full stop: with Source Serif the default wider sentence space left visible holes,
% most of all in the reference list, where every block ends in a full stop
\frenchspacing
% a third line-breaking pass for paragraphs with long inline formulas, which otherwise ran into the margin
\setlength{\emergencystretch}{1.5em}
% break points for long words of the paper that the hyphenation patterns do not know
\hyphenation{re-pa-ram-e-tri-sa-tion re-pa-ram-e-tri-sa-tions re-pa-ram-e-trise re-pa-ram-e-trised re-pa-ram-e-tris-ing}
% no single line of a paragraph alone at the foot or the head of a page, also inside the breakable result boxes
% (article sets \raggedbottom, so a page that ends a line early stays short instead of being stretched)
\clubpenalty=10000 \@clubpenalty=\clubpenalty \widowpenalty=10000

